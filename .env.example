# Required: fal.ai key for image generation, 3D, rigging and speech-to-text (plus the speech fallback)
FAL_KEY=

# Required for real conversations: Anthropic API key for the avatar's persona
ANTHROPIC_API_KEY=

# Recommended: ElevenLabs key for streaming speech with stock voices (~0.3 s to first audio).
# Also used for cloned voices when no Fish Audio key is set.
# Without it, speech falls back to MiniMax on fal (several seconds per sentence).
ELEVENLABS_API_KEY=

# Recommended: Fish Audio key for cloned voices. Fish speaks from the creator's recording,
# sent with each request, so there is no voice limit (every ElevenLabs clone takes a slot).
FISH_API_KEY=

# Public base URL (sign-in links, share links, Stripe return addresses, fal's callback).
# On Vercel leave it unset unless the site's address differs from the project's production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sign-in emails (accounts). Without a key the sign-in link is shown on the page in development,
# and sign-in is refused in production.
# RESEND_API_KEY=
# EMAIL_FROM=iident <login@yourdomain.com>

# Payments (Stripe). With no secret key billing is off: publishing isn't paywalled.
# 3D builds always need payment on a live site: without a key, production only builds for COMP_EMAILS accounts.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=        (signing secret of the webhook pointed at /api/billing/webhook)
# STRIPE_PRICE_CREATOR=         (optional price ids; without them checkout charges the listed price directly)
# STRIPE_PRICE_PRO=
# STRIPE_TAX_CODE=txcd_10105001   (tax category used when checkout creates the product; give your own prices a tax code in Stripe)
# COMP_EMAILS=                  (comma-separated accounts that get Pro without paying)

# Replies one avatar may give visitors per calendar month (0 = no limit). Each costs about 1 to 2 cents.
# MONTHLY_REPLY_LIMIT=300

# Database: a Postgres connection string. On Vercel, connecting a Postgres database from the
# Marketplace sets this for you. Left unset locally, an embedded Postgres keeps its data in DATA_DIR/pg.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Files: on Vercel, connect a private Blob store to the project (sets BLOB_STORE_ID; no token needed).
# Outside Vercel a store's read-write token works too. With neither, files are kept in DATA_DIR/files.
# BLOB_READ_WRITE_TOKEN=

# Local development only: where the embedded database and files are kept
DATA_DIR=data

# Optional model overrides (defaults shown)
# FAL_PORTRAIT_MODEL=openai/gpt-image-2.6/flare/edit     (clean straight-on portrait made from each selfie)
# PORTRAIT_QUALITY=medium   (the first drawing waits for the portrait; high takes about 6 s longer for the same likeness)
# FAL_CONCEPT_MODEL=google/nano-banana-2.1/edit     (character image; also draws the first sketch)
# CONCEPT_QUALITY=high      (only for image models with a quality setting, such as GPT Image)
# FAL_PREVIEW_MODEL=blackforestlabs/flux-3/klein/edit-image   (quick sketches)
# FAL_BACKDROP_MODEL=blackforestlabs/flux-3/klein/text-to-image   (background scenes)
# FAL_IMAGE_TO_3D_MODEL=meshy/v7.1/image-to-3d
# FAL_RIGGING_MODEL=fal-ai/meshy/rigging/multi-animation
# FAL_VOICE_CLONE_MODEL=fal-ai/minimax/voice-clone
# FAL_TTS_MODEL=fal-ai/minimax/speech-2.8-turbo   (fallback when no ElevenLabs key)
# FAL_STT_MODEL=fal-ai/wizper
# AVATAR_CHAT_MODEL=claude-opus-5-5
# ELEVENLABS_MODEL=eleven_v4_turbo
# TTS_PROVIDER=elevenlabs   # or minimax

# Where cloned voices live: fish (default when FISH_API_KEY is set), elevenlabs or minimax
# CLONE_PROVIDER=fish
# FISH_MODEL=s2.1-pro
# FISH_LATENCY=balanced   # or normal
# FISH_SAMPLE_RATE=44100
# FISH_VOICE_MODE=inline   # or model: save each recording as a Fish voice model (capped by prepaid credit)

# Switch voice cloning off: recordings are refused and avatars use stock voices.
# VOICE_CLONING=off
