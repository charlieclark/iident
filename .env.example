# Required: fal.ai key for image generation, 3D, rigging and speech-to-text (plus the speech fallback)
FAL_KEY=

# Required for real conversations: Anthropic API key for the avatar's persona
ANTHROPIC_API_KEY=

# Recommended: ElevenLabs key for streaming speech (~0.3 s to first audio) and voice cloning.
# Without it, speech falls back to MiniMax on fal (several seconds per sentence).
ELEVENLABS_API_KEY=

# Public base URL (used for share links and Open Graph images)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where the SQLite database and uploaded/generated files are stored
DATA_DIR=data

# Optional model overrides (defaults shown)
# FAL_CONCEPT_MODEL=fal-ai/nano-banana-2/edit
# CONCEPT_VARIANTS=2
# FAL_IMAGE_TO_3D_MODEL=meshy/v7.1/image-to-3d
# FAL_RIGGING_MODEL=fal-ai/meshy/rigging/multi-animation
# FAL_VOICE_CLONE_MODEL=fal-ai/minimax/voice-clone
# FAL_TTS_MODEL=fal-ai/minimax/speech-2.8-turbo   (fallback when no ElevenLabs key)
# FAL_STT_MODEL=fal-ai/wizper
# AVATAR_CHAT_MODEL=claude-opus-5-5
# ELEVENLABS_MODEL=eleven_v4_turbo
# TTS_PROVIDER=elevenlabs   # or minimax
